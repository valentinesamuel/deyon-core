{
  "compilerOptions": {
    "types": ["vitest/globals"],
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./src",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@adapters/*": [
        "adapters/*"
      ],
      "@broker/*": [
        "broker/*"
      ],
      "@config/*": [
        "configs/*"
      ],
      "@generated/*": [
        "generated/*"
      ],
      "@modules/*": [
        "modules/*"
      ],
      "@shared/*": [
        "shared/*"
      ]
    }
  },
  "exclude": ["test/load/**/*.k6.ts", "test/load/k6.config.ts"]
}