# General Config
APP_NAME=deyon-core-service
APP_HOSTNAME=localhost
APP_PORT=3001
NODE_ENV=development
TOKEN_ENCRYPTION_KEY=
CORS_WHITELIST=http(s)?:\/\/(.+)\.deyon\.com,http(s)?:\/\/(.+)\.deyon\.com

# Database Specific Settings
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_DB=deyon
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_SYNCHRONIZE=false
DATABASE_LOGGING=true
DATABASE_RETRY_ATTEMPTS=5
RUN_MIGRATIONS=true

# Swagger Settings
SWAGGER_API_ROOT=docs

# Debug & Metrics Credentials
DEBUGGER_NAME=x-debug-access
DEBUGGER_KEY=
HEALTH_NAME=x-health-key
HEALTH_KEY=

# App Authorization
APP_AUTH_NAME=x-api-token
APP_KEY=

# JWT
JWT_ACCESS_SECRET=<min-32-char-random-string>
JWT_ACCESS_EXPIRY=900
JWT_REFRESH_EXPIRY=604800

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PERMISSION_CACHE_DB=1

# Email provider selection (mailpit | sendgrid)
EMAIL_PROVIDER=mailpit

# Mailpit (used in dev/local)
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
SMTP_FROM=Deyon HMS <noreply@deyon.com>

# SendGrid (used in staging/production)
SENDGRID_API_KEY=SG.xxxxxxx
SENDGRID_FROM=noreply@deyon.com
SENDGRID_TEMPLATE_INVITE=d-xxxxxx
SENDGRID_TEMPLATE_PASSWORD_RESET=d-xxxxxx

# MFA
MFA_ISSUER=DeyonHMS

# Frontend (for invite/reset links in emails)
FRONTEND_URL=http://localhost:3000

# Sentry
SENTRY_DSN=SENTRY_DSN